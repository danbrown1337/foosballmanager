{
  "manifest_version": 3,
  "name": "Fantasy Manager",
  "version": "0.94.0",
  "description": "Weekly lineup and waiver planning, draft assistance, and roster tracking for Yahoo Fantasy Football. Roster moves and trades stay manual.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.fantasysports.yahoo.com/*",
    "https://fantasyfootballcalculator.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.fantasysports.yahoo.com/*"
      ],
      "js": [
        "src/content/overlay.js",
        "src/content/weeklyCapture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/*.json",
        "src/lib/*.js",
        "src/engine/*.js",
        "src/content/*.js"
      ],
      "matches": [
        "https://*.fantasysports.yahoo.com/*"
      ]
    }
  ]
}
