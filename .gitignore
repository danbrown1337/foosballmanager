# Per-person data. Profiles hold Yahoo credentials, OAuth tokens and live
# draft state — none of it belongs in the repo. The whole tree is ignored so
# a new profile can never leak by being added before this list catches up.
profiles/

# Legacy single-user locations, kept ignored so an old checkout can't commit
# secrets after upgrading.
config/yahoo_credentials.json
yahoo_tokens.json
draft_state.json
my_roster.csv
league_rosters.csv

# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.coverage

# The extension itself needs zero npm dependencies — but node_modules
# appears here if anyone runs the optional load_check.js verification
# by installing Playwright directly in extension/ instead of a scratch dir.
extension/node_modules/
extension/package-lock.json

# OS
.DS_Store
